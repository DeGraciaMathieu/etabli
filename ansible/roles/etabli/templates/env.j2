APP_NAME=Etabli
APP_ENV=production
APP_KEY={{ etabli_app_key }}
APP_DEBUG=false
APP_URL=http://localhost

LOG_CHANNEL=daily

DB_CONNECTION=sqlite
QUEUE_CONNECTION=database
CACHE_STORE=database

# Doit rester plus grand que le timeout de queue-claude, sinon un run est relancé en double
DB_QUEUE_RETRY_AFTER={{ etabli_claude_timeout + 300 }}

TELEGRAM_BOT_TOKEN={{ telegram_bot_token }}
TELEGRAM_USER_ID={{ telegram_user_id }}

CLAUDE_BIN={{ etabli_home }}/.local/bin/claude
ETABLI_CODE_DIR={{ etabli_code_dir }}
ETABLI_CLAUDE_TIMEOUT={{ etabli_claude_timeout }}
