[Unit]
Description=Claude Code Remote Control (tmux)
After=network-online.target
Wants=network-online.target

[Service]
Type=forking
User={{ etabli_user }}
WorkingDirectory={{ etabli_code_dir }}
Environment=HOME={{ etabli_home }}
Environment=PATH={{ etabli_home }}/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/usr/bin/tmux new-session -d -s claude -c {{ etabli_code_dir }} {{ etabli_home }}/.local/bin/claude remote-control
ExecStop=/usr/bin/tmux kill-session -t claude
Restart=on-failure
RestartSec=30

[Install]
WantedBy=multi-user.target
